        "amount": { "type": "number" },
        "monthKey": { "type": "string", "minLength": 7, "maxLength": 7 },
        "endMonthKey": { "type": "string", "minLength": 7, "maxLength": 7 },
        "dueDay": { "type": "number" },
        "sourceAccountId": { "type": "string", "maxLength": 64 },
        "sourceAccountName": { "type": "string", "maxLength": 200 },
        "isRecurring": { "type": "boolean" },
        "status": { "type": "string", "enum": ["Belum Bayar", "Sudah Bayar", "Lunas", "Pending", "Terlambat"] },
        "monthStatuses": { "type": "object" },
        "paidDates": { "type": "object" },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "category", "amount", "monthKey", "isRecurring", "status", "createdAt", "updatedAt"]
    },
    "InvestmentAsset": {
      "title": "InvestmentAsset",
      "description": "Asset / financing installment schedule with late fees and addendum history stored in investments_kkb.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "institution": { "type": "string", "minLength": 1, "maxLength": 200 },
        "category": { "type": "string", "enum": ["Pinjaman / Kredit", "Aset Tetap", "Investasi Modal", "Lainnya"] },
        "principalAmount": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["ANUITAS", "BALLOON"] },
        "fixedPrincipalPerMonth": { "type": "number" },
        "interestInputType": { "type": "string", "enum": ["RP", "PERCENT"] },
        "monthlyInterestAmount": { "type": "number" },
        "monthlyInterestRate": { "type": "number" },
        "lateFeeInputType": { "type": "string", "enum": ["RP", "PERCENT"] },
        "lateFeePerMonthAmount": { "type": "number" },
        "lateFeePerMonthRate": { "type": "number" },
        "bonusInputType": { "type": "string", "enum": ["RP", "PERCENT"] },
        "bonusAmount": { "type": "number" },
        "bonusRate": { "type": "number" },
        "bonusDate": { "type": "string", "maxLength": 10 },
        "monthlyInstallment": { "type": "number" },
        "tenorMonths": { "type": "number" },
        "startMonthKey": { "type": "string", "minLength": 7, "maxLength": 7 },
        "startDate": { "type": "string", "maxLength": 10 },
        "endDate": { "type": "string", "maxLength": 10 },
        "dueDay": { "type": "number" },
        "paidMonths": { "type": "array" },
        "status": { "type": "string", "enum": ["Aktif", "Lunas", "Ditunda"] },
        "notes": { "type": "string", "maxLength": 500 },
        "originalContract": { "type": "object" },
        "addendums": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "institution", "category", "principalAmount", "monthlyInstallment", "tenorMonths", "startMonthKey", "paidMonths", "status", "createdAt", "updatedAt"]
    },
    "ClientPurchaseOrder": {
      "title": "ClientPurchaseOrder",
      "description": "Purchase order received from client stored in client_po_kkb.",
      "type": "object",
      "properties": {
        "clientPoNumber": { "type": "string", "minLength": 1, "maxLength": 64 },
        "poDate": { "type": "string", "minLength": 10, "maxLength": 10 },
        "clientName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "brandName": { "type": "string", "maxLength": 200 },
        "projectName": { "type": "string", "minLength": 1, "maxLength": 200 },
